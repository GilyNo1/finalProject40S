package movierater;

/**
 * description - The bases of what every movie will need to have or simply put
 * what a Movie is.
 *
 * @author Jaxon McGiffin
 */
public abstract class Movie {

    private String title; // title of movie
    private int year; // year movie released

    public Movie(String title, int year) {
        this.title = title;
        this.year = year;
    }

    public String getTitle() {
        return title;
    }

    public int getYear() {
        return year;
    }
}
